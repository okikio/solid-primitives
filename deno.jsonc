{
  "workspace": [
    "packages/*"
  ],
  "nodeModulesDir": "auto",
  "preferPackageJson": true,
  "lock": true,
  "lint": {
    "include": [
      "packages",
      "scripts"
    ],
    "exclude": [
      "packages/*/dist",
      "packages/*/dev",
      "packages/*/test",
      "site",
      "node_modules"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "no-slow-types",
        "no-process-global",
        "no-node-globals"
      ]
    }
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ]
  },
  "catalog": {
    "solid-js": "^1.9.7"
  },
  "catalogs": {
    "graphql": {
      "@graphql-typed-document-node/core": "^3.2.0",
      "graphql": "^16.8.1"
    },
    "supabase": {
      "@supabase/supabase-js": "^2.48.1"
    },
    "tauri": {
      "@tauri-apps/plugin-store": "*"
    },
    "node": {
      "node-fetch": "^3.3.2",
      "chokidar": "^3.5.3"
    }
  },
  "tasks": {
    "jsr:fmt": "deno fmt --check deno.jsonc packages/*/deno.jsonc",
    "jsr:dry-run": "deno publish --dry-run --check",
    "jsr:prepublish": "deno task jsr:fmt && deno task jsr:dry-run",
    "jsr:list": "deno list -r"
  },
  "allowScripts": {
    "allow": ["npm:@parcel/watcher@2.5.6", "npm:esbuild@0.28.1"],
    "deny": ["npm:esbuild@0.21.5", "npm:esbuild@0.25.12", "npm:fsevents@2.3.3"]
  }
}
